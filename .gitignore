# ============================================================
# Dubai Retail Intelligence Agent - .gitignore
# ============================================================

# -- SECRETS - never commit these ------------------------------
.env

# -- Python ----------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
venv/
.venv/

# -- ML model cache (~2GB - never commit) ----------------------
.model_cache/

# -- Vector store (regenerate with FORCE_REINGEST=true) --------
.chroma_db/
.chroma_db*/

# -- Data files ------------------------------------------------
# Policy: commit the generator scripts, not the generated data.
# All data is SYNTHETIC. Regenerate with:
#   python data/synthetic/generate_dataset.py     (catalogue)
#   python data/make_calendar.py                  (calendar + event lifts)
#   python data/generate_synthetic.py --catalogue data/synthetic/product_catalogue.csv --out-dir data/synthetic
data/synthetic/*.csv
data/synthetic/*.json
# Exception: keep metadata file (small, documents the dataset)
!data/synthetic/dataset_metadata.json
# Scratch output / backups / evaluation-only ground truth
data/synthetic_v2/
data/synthetic_v1_backup/

# -- IDE -------------------------------------------------------
.vscode/
.idea/
*.swp

# -- OS --------------------------------------------------------
.DS_Store
Thumbs.db

# -- Docker ----------------------------------------------------
# Don't ignore docker-compose.yml - that should be committed
# But ignore any local override files
docker-compose.override.yml

# -- Logs ------------------------------------------------------
*.log
logs/